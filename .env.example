# NextAuth / Auth.js Configuration
AUTH_SECRET="your-generated-auth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth App Credentials
# Obtain from GitHub -> Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Target Repository Configuration
# GitHub owner/organization and repository name housing the Discussions
GITHUB_OWNER="cscpduam-org"
GITHUB_REPOSITORY="community"

# Server-side GitHub Token for Guest Reading Access
# Allows unauthenticated visitors to browse public discussions/categories without signing in
# Obtain from https://github.com/settings/tokens (Fine-grained or classic token with read:discussion scope)
GITHUB_TOKEN="your_github_personal_access_token_here"
